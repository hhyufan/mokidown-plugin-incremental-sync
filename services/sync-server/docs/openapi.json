    "/capabilities": {
      "get": {
        "summary": "Discover enabled plugins, stable service identity and limits",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "service",
                    "instanceId",
                    "namespace",
                    "plugins"
                  ],
                  "properties": {
                    "service": {
                      "const": "mokidown-plugin-server"
                    },
                    "instanceId": {
                      "type": "string"
                    },
                    "namespace": {
                      "type": "string"
                    },
                    "authentication": {
                      "const": "access-key"
                    },
                    "registration": {
                      "const": false
                    },
                    "plugins": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "version": {
                            "type": "string"
                          },
                          "protocolVersion": {
                            "type": "integer"
