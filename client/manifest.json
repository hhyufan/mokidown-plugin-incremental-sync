{
  "format": "mokidown-extension-v1",
  "id": "mokidown.incremental-sync",
  "name": "MokiDown 增量同步服务",
  "version": "1.8.1",
  "permissions": [
    "workspace.read",
    "workspace.write",
    "storage",
    "network",
    "commands",
    "ui.statusBar",
    "ui.fileIcons",
    "editor.read",
    "editor.write"
  ],
  "fileExtensions": [
    "md",
    "markdown",
    "txt"
  ],
  "entry": "src/main.mjs",
  "configuration": {
    "help": "本机填写 http://127.0.0.1:端口；局域网填写服务器内网 IP；远程填写代理或自建反代的 HTTPS 地址。三种方式使用相同访问密钥。",
    "fields": [
      {
        "key": "endpoint",
        "type": "url",
        "label": "服务地址",
        "placeholder": "http://127.0.0.1:8787"
      },
      {
        "key": "credential",
        "type": "secret",
        "label": "访问密钥（留空保留现有密钥）"
      },
      {
        "key": "workspace",
        "type": "directory",
        "label": "选择授权目录"
      }
    ],
    "actions": {
      "save": "保存连接配置",
      "test": "保存并测试连接"
    },
    "test": {
      "path": "/capabilities",
      "check": [
        "service",
        "plugins"
      ],
      "success": "连接成功",
      "failure": "请检查服务地址、反向代理路径或隧道是否在线。"
    }
  },
  "description": "Show sync state for the current document and resolve differences inside the editor.",
  "descriptionZh": "按当前文档显示状态，在编辑器内处理差异并同步到自建服务。"
}
