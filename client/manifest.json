{
  "format": "mokidown-extension-v1",
  "id": "mokidown.incremental-sync",
  "name": "MokiDown 增量同步服务",
  "version": "1.5.1",
  "permissions": [
    "workspace.read",
    "workspace.write",
    "storage",
    "network",
    "commands",
    "ui.statusBar",
    "ui.fileIcons",
    "editor.read",
    "editor.write"
  ],
  "fileExtensions": [
    "md",
    "markdown",
    "txt"
  ],
  "entry": "src/main.mjs"
}
